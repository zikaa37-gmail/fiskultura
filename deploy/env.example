# Kopiraj u deploy/.env (van gita) i popuni. FTP_* i DEPLOY_* se koriste samo za deploy,
# sve ostalo postaje backend .env na serveru.

FTP_HOST=
FTP_PORT=21
FTP_USER=
FTP_PASSWORD=
# Putanje relativne na FTP koren naloga (home folder)
DEPLOY_APP_DIR=fiskultura_app
DEPLOY_WEB_DIR=public_html
# Nasumičan string: php -r "echo bin2hex(random_bytes(32));"
DEPLOY_SECRET=
# Prvi admin (pravi se / ažurira pri deploy-u; lozinku obrisati posle prvog deploy-a)
DEPLOY_ADMIN_EMAIL=
DEPLOY_ADMIN_PASSWORD=

APP_NAME=Fiskultura
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://fiskultura.rs
FRONTEND_URL=https://fiskultura.rs
APP_LOCALE=sr
APP_TIMEZONE=Europe/Belgrade

LOG_CHANNEL=single
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_PREFIX=fk_

JWT_SECRET=
JWT_ACCESS_TTL_MINUTES=60
JWT_REFRESH_TTL_DAYS=365

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=database

MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=mail.fiskultura.rs
MAIL_PORT=465
MAIL_USERNAME=obavestenja@fiskultura.rs
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="obavestenja@fiskultura.rs"
MAIL_FROM_NAME="Fiskultura"
NOTIFY_HOURLY_LIMIT=100
